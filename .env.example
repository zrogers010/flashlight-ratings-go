# ─── Database ───────────────────────────────────────────────────────
POSTGRES_USER=flashlight_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=flashlight
DB_PORT=5432

# ─── Web ────────────────────────────────────────────────────────────
SITE_URL=https://flashlightratings.com
NEXT_PUBLIC_API_BASE_URL=https://flashlightratings.com/api
GOOGLE_SITE_VERIFICATION=

# ─── Amazon Associates ───────────────────────────────────────────────
AMAZON_PARTNER_TAG=your-tag-20
NEXT_PUBLIC_AMAZON_TAG=your-tag-20

# ─── Amazon Creators API (primary product data source) ──────────────
# Register in Associates Central; requires ~10 qualifying sales in the
# trailing 30 days. Used by rainforest-sync (catalog refresh + discovery)
# and the worker (DB snapshots).
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# ─── Rainforest API (ratings reinforcement + failover) ───────────────
# Paid scraper. Reinforces star ratings the Creators API withholds and
# takes over the whole sync if Creators credentials are rejected.
RAINFOREST_API_KEY=

# ─── Deploy ─────────────────────────────────────────────────────────
DOMAIN=flashlightratings.com
