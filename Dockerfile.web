FROM node:22-alpine

WORKDIR /app

COPY web/package*.json ./
RUN npm ci

COPY web/ ./

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ARG API_BASE_URL=http://localhost:8080
ARG NEXT_PUBLIC_AMAZON_TAG=
ARG NEXT_PUBLIC_AWIN_PUBLISHER_ID=
ARG NEXT_PUBLIC_AWIN_OLIGHT_MERCHANT_ID=
ARG NEXT_PUBLIC_AVANTLINK_WEBSITE_ID=
ARG NEXT_PUBLIC_AVANTLINK_FENIX_MERCHANT_ID=

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV API_BASE_URL=${API_BASE_URL}
ENV NEXT_PUBLIC_AMAZON_TAG=${NEXT_PUBLIC_AMAZON_TAG}
ENV NEXT_PUBLIC_AWIN_PUBLISHER_ID=${NEXT_PUBLIC_AWIN_PUBLISHER_ID}
ENV NEXT_PUBLIC_AWIN_OLIGHT_MERCHANT_ID=${NEXT_PUBLIC_AWIN_OLIGHT_MERCHANT_ID}
ENV NEXT_PUBLIC_AVANTLINK_WEBSITE_ID=${NEXT_PUBLIC_AVANTLINK_WEBSITE_ID}
ENV NEXT_PUBLIC_AVANTLINK_FENIX_MERCHANT_ID=${NEXT_PUBLIC_AVANTLINK_FENIX_MERCHANT_ID}
ENV NODE_ENV=production
ENV PORT=3000

RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
